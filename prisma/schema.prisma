generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  APPROVER
}

enum PoStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  roles        Role[]
  createdPos   PurchaseOrder[] @relation("CreatedPos")
  actions      ActionHistory[]
  createdAt    DateTime      @default(now())
}

model PurchaseOrder {
  id              String        @id @default(cuid())
  poNumber        String        @unique
  poDate          String
  vendorName      String
  documentTotalPaise Int
  calculatedTotalPaise Int
  totalsMatch     Boolean
  extractionMethod String
  status          PoStatus      @default(DRAFT)
  originalFileKey String
  originalFileName String
  creatorId       String
  creator         User          @relation("CreatedPos", fields: [creatorId], references: [id])
  lineItems       LineItem[]
  actions         ActionHistory[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LineItem {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku        String
  description String
  quantity   Int
  unitPricePaise Int
  lineTotalPaise Int
  sortOrder  Int
}

model ActionHistory {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User          @relation(fields: [actorId], references: [id])
  action     String
  fromStatus PoStatus
  toStatus   PoStatus
  remark     String?
  createdAt  DateTime      @default(now())
}
